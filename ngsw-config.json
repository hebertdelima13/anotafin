{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",

  "index": "/index.html",

  "navigationUrls": ["/**"],

  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/index.html",
          "/manifest.webmanifest",
          "/ngsw.json",
          "/ngsw-worker.js",
          "/*.css",
          "/*.js"
        ]
      }
    },
    {
      "name": "assets",
      "installMode": "prefetch",
      "resources": {
        "files": ["/assets/**", "/icons/**"]
      }
    }
  ]
}
